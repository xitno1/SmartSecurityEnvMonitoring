
/* 标签样式：白色文字、字体大小 */
QLabel {
    color: white;
    font-size: 20px;
}

/* 输入框、下拉框、数值框通用样式：白色背景、圆角、边框、字体 */
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox {
    background-color: white;
    border: 1px solid #CCCCCC;
    border-radius: 3px;
    padding: 5px;
    font-size: 14px;
}

/* 按钮样式：深蓝色背景、白色文字、悬停效果 */
QPushButton {
    background-color: #2F5496;
    color: white;
    border: none;
    border-radius: 3px;
    padding: 6px 12px;
    font-size: 14px;
}
QPushButton:hover {
    background-color: #3A64AD;
}

/* 分组框样式：白色文字、边框、标题样式 */
QGroupBox {
    color: white;
    border: 1px solid #CCCCCC;
    border-radius: 5px;
    margin-top: 10px;
    padding: 10px;
    font-size: 16px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 5px;
}

/* 全局QMessageBox样式 */
QMessageBox {
    background-color: #2b2b2b; /* 深色背景，和白色文字对比 */
    color: #ffffff; /* 文字默认白色 */
}

/* QMessageBox按钮样式 */
QMessageBox QPushButton {
    background-color: #444444;
    color: #ffffff;
    border: none;
    padding: 5px 15px;
    border-radius: 4px;
}

QMessageBox QPushButton:hover {
    background-color: #555555;
}

QMessageBox QPushButton:pressed {
    background-color: #666666;
}

/* QMessageBox提示文本（警告/错误信息） */
QMessageBox QLabel {
    color: #ffffff; /* 确保提示文字是白色 */
}

/* QMessageBox标题栏 */
QMessageBox QLabel#qt_msgbox_label {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
}

